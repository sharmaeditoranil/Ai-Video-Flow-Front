RewriteEngine On

# 1. Redirect /index.html to clean root /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2. Redirect other .html files to extensionless clean URLs (excluding Google Search Console verification file)
RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/google[a-z0-9]+\.html$ [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Internally map clean extensionless URLs to .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

